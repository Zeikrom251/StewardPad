# Which LMU adapter to use. `mock` needs nothing running; `rest` needs LMU open.
LMU_ADAPTER=rest

# Where LMU's REST API listens. Only used by the `rest` adapter.
#
# LMU binds this to 127.0.0.1 on Windows — it does NOT listen on 0.0.0.0. If
# the backend runs anywhere other than that same Windows session (WSL, another
# machine), `localhost` is not where the game is and every poll fails with
# "Cannot reach LMU". For WSL2, enable mirrored networking in %USERPROFILE%\
# .wslconfig (`[wsl2]` / `networkingMode=mirrored`) and run `wsl --shutdown`;
# otherwise point this at the host that is actually running the game.
LMU_BASE_URL=http://localhost:6397

# Backend HTTP port. The Vite dev server proxies /api and the socket here.
PORT=3000

# Where incidents are saved. Defaults to <repo root>/data — set this to move
# the steward's session file somewhere else (e.g. a synced folder).
DATA_DIR=
