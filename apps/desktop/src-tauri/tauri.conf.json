{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StewardPad",
  "version": "0.1.0-alpha.3",
  "identifier": "com.emeraldstudio.stewardpad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StewardPad",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 760,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src ipc: http://ipc.localhost https://discord.com https://discordapp.com https://ptb.discord.com https://canary.discord.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["stewardpad"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBRjg0MkJDQjMyQzFEMkYKUldRdkhTeXp2RUw0T214QVUxemtXQzZiVUI1cThKZzM4UWJ5WndMaFYySE9sNWFqSEtjdDVBMHIK",
      "endpoints": [
        "https://github.com/Zeikrom251/StewardPad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
